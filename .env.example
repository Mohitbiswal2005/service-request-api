# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Replace with your own Atlas connection string, or use the local docker-compose one:
#   mongodb://localhost:27017/service-request-api
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/service-request-api

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_secret

# Access token lifetime. Short by design - the refresh token covers long sessions.
JWT_EXPIRES_IN=15m

# Refresh token lifetime in days.
REFRESH_TOKEN_DAYS=7
